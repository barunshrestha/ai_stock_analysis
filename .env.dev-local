# Local dev alongside Docker (used by ./start_dev_local.sh only).
# Docker keeps :8000 (backend), :3002 (frontend), :5432 (postgres).
# Local dev uses :8001 (backend), :3003 (frontend).
#
# DATABASE_URL is read from .env (same Postgres as Docker on localhost:5432).
# Copy .env.example → .env if missing.

CORS_ORIGINS=http://localhost:3003,http://127.0.0.1:3003
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b
OLLAMA_ANALYSIS_MODEL=deepseek-r1:1.5b
OLLAMA_NUM_CTX=8192

# Optional — FINNHUB_API_KEY is loaded from .env when set there
