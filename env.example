# PostgreSQL Database Configuration
# Copy this file to .env and update with your local PostgreSQL credentials

# Option 1: Full DATABASE_URL (recommended)
DATABASE_URL=postgresql://username:password@localhost:5432/stock_analysis

# Option 2: Individual connection parameters
PGHOST=localhost
PGPORT=5432
PGUSER=your_username
PGPASSWORD=your_password
PGDATABASE=stock_analysis

# Ollama (local LLM) configuration for AI-powered stock analysis
# No API key required - ensure Ollama is running (e.g. ollama serve)
# Default: http://localhost:11434 with model gemma3:4b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=deepseek-r1:latest

# Ollama Analysis page model
# Example:
# OLLAMA_ANALYSIS_MODEL=gemma3:4b
# If not set, defaults to gemma3:4b

# Gemini (Issue #6 Wall Street–style equity research memo)
# Required for POST /api/ai/wall-street
# GEMINI_API_KEY=your_google_ai_studio_key
# GEMINI_MODEL=gemini-3.6-flash

# Authentication (Clerk) — see README "Authentication setup"
# Frontend API URL from Clerk Dashboard → API keys (no trailing slash). Required for signed-in features.
CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Optional: override the JWKS URL (defaults to $CLERK_ISSUER/.well-known/jwks.json)
# CLERK_JWKS_URL=
# Frontend origins allowed in the token's azp claim (defaults to CORS_ORIGINS)
# CLERK_AUTHORIZED_PARTIES=http://localhost:3003,http://localhost:3002
# Comma-separated emails that get the admin role (edit industry assignments)
ADMIN_EMAILS=
# Your Clerk user id (user_...). Rows created before sign-in existed are assigned to this user on startup.
LEGACY_OWNER_USER_ID=
# Max AI memo generations per user per hour
# AI_RATE_LIMIT_PER_HOUR=30

