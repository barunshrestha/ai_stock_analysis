# Copy to .env and adjust as needed:
#   cp .env.example .env
#
# Used by docker compose and local dev (backend reads from repo root).

# --- Docker Compose (bundled Postgres) ---
# Backend in Docker uses @postgres, not @localhost (see DOCKER_DATABASE_URL).
DOCKER_DATABASE_URL=postgresql://stock:stock@postgres:5432/stock_analysis
POSTGRES_USER=stock
POSTGRES_PASSWORD=stock
POSTGRES_DB=stock_analysis

# --- Local dev alongside Docker (./start_dev_local.sh) ---
# Uses ports 8001 + 3003 while Docker keeps 8000 + 3002. See .env.dev-local.

# --- Local dev only, no Docker (./start_dev.sh) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/stock_analysis

# Frontend build-time API URL (browser → backend). Rebuild after changing:
#   docker compose up -d --build
NEXT_PUBLIC_API_URL=http://localhost:8000

# Must match the URL you open in the browser (Docker maps host 3002 → container 3000)
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Optional — AI analysis (Ollama on host; Docker backend uses host.docker.internal)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b

# Optional — economic calendar strip on Dashboard
FINNHUB_API_KEY=
